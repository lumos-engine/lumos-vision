# Allow the Screen Sight service user to create v4l2loopback nodes without a
# password. Install as /etc/sudoers.d/screen-sight-loopback (mode 0440).
# visudo -c -f this-file before installing.

screensight ALL=(root) NOPASSWD: /usr/lib/screen-sight/screen-sight-loopback, /sbin/modprobe v4l2loopback *
