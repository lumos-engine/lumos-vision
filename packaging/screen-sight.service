[Unit]
Description=Screen Sight (camera -> rectified virtual webcam)
Documentation=https://github.com/shivanshBTW/screen-sight
After=network-online.target
Wants=network-online.target
# Load loopback before us if you use the modprobe.d snippet in the README.

[Service]
Type=simple

# Adjust these three to match your install.
User=screensight
Group=video
WorkingDirectory=/opt/screen-sight

Environment=PYTHONUNBUFFERED=1
Environment=SCREENSIGHT_CONFIG=/etc/screen-sight/config.yaml
ExecStart=/opt/screen-sight/.venv/bin/python -m processor run

# The camera can be unreachable at boot, or rebooted itself; the processor
# handles that internally, but restart anyway if it ever exits.
Restart=always
RestartSec=5

# The service only needs to read its config and write to the loopback device.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Needed for /dev/videoN.
DeviceAllow=char-video4linux rw
SupplementaryGroups=video

# Uncomment if you enable output.file or debug snapshots.
# ReadWritePaths=/var/lib/screen-sight

# It is a video pipeline on a slow machine; do not let it starve the desktop,
# but do give it priority over background housekeeping.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=4

[Install]
WantedBy=multi-user.target
